<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>RaspberryDotNet.FrameBuffer</PackageId>
    <Title>RaspberryDotNet.FrameBuffer</Title>
    <Description>Library for Raspberry Pi.</Description>
    <PackageTags>raspberrypi</PackageTags>
  </PropertyGroup>

</Project>
